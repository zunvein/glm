# ---------------------------------------------------------------------------
# GLM Bridge — Z.AI Proxy API  |  Environment template
# Copy to `.env` and fill in your own values. Every secret below is a
# placeholder — nothing here is a real credential.
#
# The bridge reads these from the environment (systemd, docker -e, shell,
# or a dotenv loader). No secret is required to START the server; guest
# mode works for basic text completions, but you'll want at least one real
# Z.AI token for vision uploads and the full model catalog.
# ---------------------------------------------------------------------------

# --- Server -------------------------------------------------------------
# TCP port the HTTP server listens on.
PORT=3001

# Bind address.
HOST=0.0.0.0

# Client auth token. Clients pass it as `Authorization: Bearer <this>` or,
# for Anthropic-compatible calls, as `x-api-key: <this>`. Change it!
AUTH_TOKEN=change-me-super-secret

# Overall request timeout in milliseconds.
TIMEOUT=300000

# --- Z.AI account(s) -----------------------------------------------------
# A SINGLE account token (a Z.AI JWT from a logged-in browser session).
# Setting it skips guest initialization and unlocks all models + vision.
# Leave empty to run in guest mode (limited models, no vision uploads).
ZAI_TOKEN=

# MULTI-ACCOUNT rotation (recommended): comma-separated list of one or more
# Z.AI JWTs. The bridge round-robins requests across them per-call, which
# spreads the per-account / per-model concurrency limits (the main reason
# Z.AI rejects bursts with "Model is currently at capacity").
#
#   ZAI_TOKENS="<acct1-jwt>,<acct2-jwt>,..."
#
# If set, ZAI_TOKENS is authoritative and overrides ZAI_TOKEN (the first
# entry is also used as the implicit guest-skip token). N>=1.
ZAI_TOKENS=

# --- Agent mode ----------------------------------------------------------
# Translates OpenAI/Anthropic tools+roles into the single user prompt Z.AI
# accepts, then maps TOOL_CALL blocks back to native tool_calls. Values:
#   0|false|no|off          -> off
#   1|true|yes|on|modern    -> on (default shim)
#   legacy                  -> on with the old [ROLE:] shim
AGENT_MODE=false

# Shim variant override: `modern` (default) or `legacy`. Takes precedence
# over the implicit variant chosen by AGENT_MODE.
AGENT_MODE_VARIANT=modern

# --- Logging -------------------------------------------------------------
# `debug` dumps every Z.AI request/response, SSE line, and header.
LOG_LEVEL=info

# `text` (default) or `json`.
LOG_FORMAT=text

# --- Streaming / session pool -------------------------------------------
# Runes held back at a live stream tail to absorb Z.AI `edit_content`
# backtracks before they reach the client (0 disables). Default 24.
STREAM_HOLDBACK=24

# Legacy synchronous session flow (one chat created per request, still
# deleted after use). Default 0/false (async pre-warmed pool).
SYNC_MODE=false

# Standing batch of ready chat sessions (async mode).
SESSION_POOL_SIZE=5

# Seconds to wait for a pooled session before creating one directly
# (0 = wait forever). Default 10.
SESSION_ACQUIRE_TIMEOUT=10

# --- Upstream pacing -----------------------------------------------------
# Minimum gap in ms between consecutive requests to Z.AI / Aliyun, enforced
# by ONE shared gate across all upstream transports (so alternating calls
# between Z.AI and the Aliyun captcha can't collapse the real gap to zero).
# This paces bursts so the Aliyun WAF doesn't block your egress IP.
# Default: a random 200–500 ms (a fixed gap is a fingerprint).
# Set to 0 to disable pacing.
UPSTREAM_MIN_INTERVAL_MS=

# --- Misc ----------------------------------------------------------------
# How long (ms) the /health token count stays cached before the next probe
# re-queries the token DB. <=0 keeps the default 5000.
TOKEN_COUNT_TTL_MS=5000

# Network proxies (optional). HTTPS_PROXY honored first, then HTTP_PROXY,
# then ALL_PROXY.
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=